# Copy to .env for local development. Never commit a real .env.
#
# Only the values that are genuinely yours belong here. The platform is
# detected (app/deployment.py), and BASE_URL, PORT, SESSION_COOKIE_SECURE
# and FLASK_ENV are derived from it on Codespaces, Railway and Render —
# set them only to override what was detected.

FLASK_ENV=development
SECRET_KEY=
JWT_SECRET=

# MongoDB. Local server, or an Atlas cluster:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# An Atlas SRV URI needs the network allowlist to include the host that
# connects — a Codespace, a Railway or Render service and a workstation
# are all different addresses.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=feedme_dev

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=var/uploads

# Overrides. Each has a detected default; uncomment only to force one.
# DEPLOY_PLATFORM=render          # local | codespaces | railway | render
# BASE_URL=http://localhost:5000
# PORT=5000
# SESSION_COOKIE_SECURE=false
# TRUST_PROXY_HEADERS=false
# WEB_CONCURRENCY=2               # gunicorn workers
